# Chronova Environment Variables Example

# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET="change_me_to_a_secure_random_string"

# Database Configuration
MONGO_URI="mongodb://localhost:27018/chronova"

# JWT Configuration
JWT_SECRET_KEY="change_me_to_a_secure_token_secret"

# logging level
LOG_LEVEL=info

# Third-Party Integrations

# Google Auth (Passport)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Razorpay Payments
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_SECRET_KEY="your_razorpay_secret_key_here"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# Nodemailer Service (Gmail)
EMAIL_USER="your_email_address@gmail.com"
EMAIL_PASS="your_app_specific_gmail_password_here"
